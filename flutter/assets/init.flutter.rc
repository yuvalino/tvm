umask 022
# Host paths scripts and programs name for their interpreter (#!/bin/sh,
# #!/usr/bin/env bash, system(3)): bind the VM's own over them (see INITRC.md, mount)
mount --bind /tvm/bin/sh:/bin/sh
mount --bind /tvm/bin/bash:/bin/bash
mount --bind /tvm/bin/env:/usr/bin/env
setenv TVM_SHELL=/tvm/bin/bash
setenv? TVM_NOEMU=libdropbear:libbash:libtoybox:libvim:libsftpserver:libcurl:libless:libnano:libsqlite:libgit:libgit-remote-http:libgit-http-fetch
setenv TERMINFO=/tvm/share/terminfo
setenv? PAGER=less
setenv? LESS=-R
setenv? EDITOR=nano
mkdir $HOME/.dropbear
echo TVM initialized
