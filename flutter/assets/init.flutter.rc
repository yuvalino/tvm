umask 022
# Host paths scripts and programs name for their interpreter (#!/bin/sh,
# #!/usr/bin/env bash, system(3)): bind the VM's own over them (see INITRC.md, mount)
mount --bind /tvm/bin/sh:/bin/sh
mount --bind /tvm/bin/bash:/bin/bash
mount --bind /tvm/bin/env:/usr/bin/env
# The macOS keychain tool (arm64e, not loadable in TVM): Claude Code reads
# its login from it, and a failing exec is not the same as "not found"
mount --bind /tvm/bin/security:/usr/bin/security
# The Python standard library ships in the app bundle (scripts/embed_frameworks.sh),
# not in the initrd, which is read into memory whole
mount --bind $TVM_RESOURCES/python/lib:/tvm/lib
# Likewise clang's toolchain bundle: its resource directory and the SDK
# (scripts/build_llvm.sh)
mount --bind $TVM_RESOURCES/llvm:/tvm/llvm
# Node's npm and corepack (when the app ships Node; scripts/embed_frameworks.sh)
mount --bind $TVM_RESOURCES/node:/tvm/node
setenv TVM_SHELL=/tvm/bin/bash
setenv? TVM_NOEMU=libdropbear:libbash:libtoybox:libvim:libsftpserver:libcurl:libless:libnano:libsqlite:libgit:libgit-remote-http:libgit-http-fetch:libpython:libllvm:libnode:librg:libbun
setenv TERMINFO=/tvm/share/terminfo
setenv? PAGER=less
setenv? LESS=-R
setenv? EDITOR=nano
# CA certificates for OpenSSL's own verification (Python's ssl); see
# scripts/CMakeLists.txt
setenv? SSL_CERT_FILE=/tvm/etc/ssl/cacert.pem
# Node runs V8 without its JIT: an app cannot map executable memory. That
# leaves it no WebAssembly, which node's fetch() parses HTTP with; the
# preload gives it one on node's http module (scripts/node/tvm-fetch.cjs).
# npm installs global packages under ~/.local (bin/ is on PATH,
# /tvm/etc/profile)
setenv? NODE_OPTIONS=--jitless --require=/tvm/node/tvm-fetch.cjs
setenv? NPM_CONFIG_PREFIX=$HOME/.local
# Bun (when the app ships it) runs JavaScriptCore without its JIT, as an
# app cannot map executable memory: bun itself and the compiled Bun
# programs execve runs on it (tvm.c, "Bun programs")
setenv? BUN_JSC_useJIT=0
# Claude Code searches with the rg on PATH, the app's own (/tvm/bin/rg),
# rather than the one in its package, which the app could only emulate
setenv? USE_BUILTIN_RIPGREP=0
# Its scratch files (each Bash command's output among them) go under /tmp
# on Darwin, whatever TMPDIR says: /private/var/tmp on iOS, outside the
# app's sandbox, and every Bash command failed (EPERM, mkdir claude-501)
setenv? CLAUDE_CODE_TMPDIR=$TMPDIR
mkdir $HOME/.dropbear
echo TVM initialized
