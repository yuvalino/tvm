umask 022
# Host paths scripts and programs name for their interpreter (#!/bin/sh,
# #!/usr/bin/env bash, system(3)): links to the VM's own (see INITRC.md, bind)
bind /tvm/bin/sh:/bin/sh
bind /tvm/bin/bash:/bin/bash
bind /tvm/bin/env:/usr/bin/env
setenv TVM_SHELL=/tvm/bin/bash
setenv ENV=$HOME/.forklessrc
setenv? TVM_NOEMU=libdropbear.dylib:libbash.dylib:libtoybox.dylib:libvim.dylib:libsftpserver.dylib:libcurl.dylib:libless.dylib:libnano.dylib:libsqlite.dylib:libgit.dylib:libgit-remote-http.dylib:libgit-http-fetch.dylib
setenv TERMINFO=/tvm/share/terminfo
setenv? PAGER=less
setenv? LESS=-R
setenv? EDITOR=nano
mkdir $HOME/.dropbear
echo TVM initialized
