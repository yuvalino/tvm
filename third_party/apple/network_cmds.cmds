# network_cmds — needs the private-header prelude (see apple_prelude.h) plus
# __APPLE_USE_RFC_3542, INET6 and IPSEC, which is what Apple's own xcconfig
# passes (IPSEC: netstat's pfkey protocol table, ping/ping6's -P policy
# option through libipsec, an SDK dylib TVM's ulinker loads through the host).
# Excluded: traceroute/traceroute6 (libpcap is not available on iOS).
#common|network_cmds_lib/network_cmds_lib.c network_cmds_lib/gmt2local.c
#cflags|-include @APPLE@/apple_prelude.h -I@SRC@/network_cmds_lib -D__APPLE_USE_RFC_3542=1 -DINET6=1 -DIPSEC=1
#libs|-lipsec

# command|subdir|sources (blank = all *.c)|extra cflags|platform (blank = both)
arp|arp.tproj||
dnctl|dnctl||
ifconfig|ifconfig.tproj||
kdumpd|kdumpd.tproj||
ndp|ndp.tproj||
netstat|netstat.tproj||
ping|ping.tproj||
ping6|ping6.tproj||
rarpd|rarpd.tproj||
route|route.tproj||
rtsol|rtsol.tproj||
spray|spray.tproj||
