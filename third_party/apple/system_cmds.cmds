# system_cmds — commands that build against the public SDK + third_party/apple/include.
# Excluded (closed frameworks / not present on iOS):
#   chpass,chkpasswd  OpenDirectory     zlog   CoreSymbolication
#   nvram,zprint,iostat  private IOKit  gcore  dyld_introspection
#   fs_usage,latency,sc_usage  ktrace    at,atrun,reboot,shutdown,memory_pressure
#   arch              links CoreFoundation; TVM's ulinker resolves libSystem
#                     only, so a second dylib dependency will not load.
#                     `uname -m` from toybox covers it.
#   getconf           its tables (confstr.c, limits.c, ...) are generated by a
#                     script phase in Apple's Xcode project; toybox already
#                     provides getconf in the initrd.

# command|subdir|sources (blank = all *.c)|extra cflags|platform (blank = both)
ac|ac||
accton|accton||
cpuctl|cpuctl||
dmesg|dmesg||
dynamic_pager|dynamic_pager||
hostinfo|hostinfo||
kpgo|kpgo||
login|login||
lsmp|lsmp||
ltop|ltop||
mean|mean||
mkfile|mkfile||
mslutil|mslutil||
newgrp|newgrp||
nologin|nologin||
proc_uuid_policy|proc_uuid_policy||
purge|purge||
pwd_mkdb|pwd_mkdb||
stackshot|stackshot||
sync|sync||
sysctl|sysctl||
vifs|vifs||
vipw|vipw||
vm_purgeable_stat|vm_purgeable_stat||
vm_stat|vm_stat||
wait4path|wait4path||
wordexp-helper|wordexp-helper||
zic|zic||-DHAVE_GETTEXT=0
