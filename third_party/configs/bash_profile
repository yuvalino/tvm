# /tvm/etc/profile — read by bash for login shells (-bash, bash -l, sh -l).
#
# A login shell does not read /tvm/etc/bash.bashrc, so it is sourced here:
# the prompt and the TERM fallback are the same for login and non-login
# shells. Before $ENV, so a user's rc file can override them.
[ -f /tvm/etc/bash.bashrc ] && . /tvm/etc/bash.bashrc

# TVM's rc files export ENV (e.g. ENV=$HOME/.forklessrc); bash only honours
# $ENV itself when invoked as `sh`, so source it here for login shells too.
[ -n "$ENV" ] && [ -f "$ENV" ] && . "$ENV"
