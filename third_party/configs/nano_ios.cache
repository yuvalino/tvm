# Autoconf cache for the iOS cross-build of nano (scripts/build_nano.sh).
#
# nano's gnulib configure has dozens of AC_RUN_IFELSE probes that cannot run
# when cross-compiling and fall back to pessimistic guesses ("guessing no"),
# which would give the iOS nano a different set of gnulib replacement
# functions than the macOS one (rpl_lstat, rpl_getcwd, rpl_readlink, ...).
# Both targets share the same libSystem and run inside TVM, so the answers
# measured by the native macOS configure are used for iOS as well. Only the
# probes iOS actually guesses are listed; everything else is detected.
#
# Regenerate after a nano/gnulib bump: build nano for macos-arm64 and
# ios-arm64, then list every cache variable whose value in the iOS
# config.log contains "guessing" together with its value from the macOS
# config.log.
ac_cv_func_malloc_0_nonnull=yes
am_cv_func_working_getline=yes
gl_cv_func_btowc_consistent=yes
gl_cv_func_btowc_nul=yes
gl_cv_func_dup2_works=yes
gl_cv_func_fcntl_f_dupfd_cloexec=yes
gl_cv_func_fcntl_f_dupfd_works=yes
gl_cv_func_fnmatch_posix=no
gl_cv_func_frexp_works=yes
gl_cv_func_frexpl_works=yes
gl_cv_func_fstatat_zero_flag=yes
gl_cv_func_futimens_works=no
gl_cv_func_getcwd_null=yes
gl_cv_func_getdtablesize_works=yes
gl_cv_func_getlogin_r_works=no
gl_cv_func_getopt_posix=no
gl_cv_func_isnanf_works=yes
