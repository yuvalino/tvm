# TVM init.rc

# Mount rootfs
mount output/$PLATFORM/lib/initrd.cli.cpio:/tvm

# Host paths scripts and programs name for their interpreter (#!/bin/sh,
# #!/usr/bin/env bash, system(3)): bind the VM's own over them, since the
# host's are not loadable in TVM (see INITRC.md, mount)
mount --bind /tvm/bin/sh:/bin/sh
mount --bind /tvm/bin/bash:/bin/bash
mount --bind /tvm/bin/env:/usr/bin/env
# The macOS keychain tool, which TVM cannot run either (an arm64e system
# binary): exec'ing it failed with ENOEXEC. Bound to the VM's own, a
# keychain with no entries (scripts/security.sh)
mount --bind /tvm/bin/security:/usr/bin/security

# Environment setup
setenv TVM_SHELL=/tvm/bin/bash
setenv SHELL=/tvm/bin/bash
setenv PATH=/tvm/bin:$PATH
setenv? TVM_NOEMU=/tvm/bin/dropbear:/tvm/bin/bash:/tvm/bin/sh:/tvm/bin/toybox:/tvm/bin/vim:/tvm/bin/sftp-server:/tvm/bin/curl:/tvm/bin/less:/tvm/bin/nano:/tvm/bin/sqlite3:/tvm/bin/git:/tvm/libexec/git-core/git-remote-http:/tvm/libexec/git-core/git-http-fetch
# Terminfo database of the static ncursesw bash, vim, less and nano link
# (scripts/build_ncurses.sh); also its compiled-in default, exported so a
# host TERMINFO in the environment cannot redirect it
setenv TERMINFO=/tvm/share/terminfo
# Pager/editor defaults, kept if the environment already has them
setenv? PAGER=less
setenv? LESS=-R
setenv? EDITOR=nano
# CA certificates for OpenSSL's own verification; see scripts/CMakeLists.txt
setenv? SSL_CERT_FILE=/tvm/etc/ssl/cacert.pem
umask 022
mkdir $HOME/.dropbear

echo TVM initialized
